# Rename this file to .env and configure your local paths
HOST_USER_DIR=/home/your_username
SHARED_NVME_MOUNT=/mnt/your_fast_drive
PROXY_DOMAIN=your.proxy.domain.com

# Which image `make up` / `docker compose up` runs:
#   local  = whatever `make build` produced last
#   stable = the image frozen with `make bake` (recommended once it works)
A1111_TAG=local

# Where `make save` writes image snapshots (default: $SHARED_NVME_MOUNT/tdeforum/images)
#IMAGE_SNAPSHOT_DIR=/mnt/your_fast_drive/tdeforum/images

# Optional build overrides; leave unset to use the pinned refs in Dockerfile.a1111
#A1111_REF=
#DEFORUM_REF=
#CONTROLNET_REF=
