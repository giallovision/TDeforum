+# Tail weight 1 -> 0 over the overlap at the start of each loop (smoothstep: no kink at
+# either end), 0 afterwards.
+_CROSS = ('(lambda p, o: (lambda w: w * w * (3.0 - 2.0 * w))(1.0 - p / o) if 0 < o and p < o else 0.0)'
