+def _input_index(offset):
+    """Init-video frame for the loop playhead: start + stride * render frame (the frame Deforum used)."""
+    return ('int(parent().par.Loopinstart.eval() or 0) + int(parent().par.Loopinstride.eval() or 1) * '
