From d59b5366c7e639c20b18a237bfb082aeda3c0934 Mon Sep 17 00:00:00 2001
From: Joseph <joseph@giallovision.com>
Date: Sat, 17 Oct 2026 06:01:20 +0000
Subject: [PATCH] Send Zoe depth as Midas-3-Hybrid: Deforum's ZoeDepth crashes
 with our image's timm

---
 docs/deforum_parameters.md   |  4 ++--
 scripts/tdeforum/__init__.py |  2 +-
 scripts/tdeforum/payload.py  | 16 ++++++++++++++++
 scripts/tdeforum/schema.py   |  4 +++-
 tests/test_payload.py        |  8 ++++++++
 5 files changed, 30 insertions(+), 4 deletions(-)

diff --git a/docs/deforum_parameters.md b/docs/deforum_parameters.md
index 8624021..a9ba757 100644
--- a/docs/deforum_parameters.md
+++ b/docs/deforum_parameters.md
@@ -1,6 +1,6 @@
 # deforum COMP: parameter reference
 
-Every custom parameter of the `deforum` Base COMP, page by page, as built by `build_master_ui` (tdeforum 0.12.0). **TD name** is the parameter's name in TouchDesigner (`op('deforum').par.<name>`); **default** is the baseline value.
+Every custom parameter of the `deforum` Base COMP, page by page, as built by `build_master_ui` (tdeforum 0.12.1). **TD name** is the parameter's name in TouchDesigner (`op('deforum').par.<name>`); **default** is the baseline value.
 
 Parameters marked **MOD** (their label on the COMP starts with `~`) are the driveable (keyframeable) ones: a float base value plus a `<name>raw` override. Type a Deforum schedule into the raw one (e.g. `0:(1), 30:(1.04)`) and it is sent as written, ignoring the base and any modulation; leave it empty to use the base + CHOP link + Mod Matrix + Mod CHOP.
 
@@ -120,7 +120,7 @@ Driveable parameters: `Zoom`, `Angle`, `Transformcenterx`, `Transformcentery`, `
 |---|---|---|---|
 | `Pagepresetcamera` | Page Preset (Camera & Depth) | none | Quick presets that change only this page's parameters; they stack with other pages. None puts this page's values back. |
 | `Usedepthwarping` | Use Depth Warping | On | 3D: warp the previous frame through its depth map (real parallax) instead of a flat transform. |
-| `Depthalgorithm` | Depth Algorithm | Midas-3-Hybrid | Depth model Deforum uses for 3D warping (MiDaS hybrid by default; Zoe/AdaBins/LeReS alternatives). |
+| `Depthalgorithm` | Depth Algorithm | Midas-3-Hybrid | Depth model Deforum uses for 3D warping (Midas-3-Hybrid by default). The Zoe options crash in our A1111 image, so they are sent as Midas-3-Hybrid with a warning. |
 | `Midasweight` | Midas Weight | 0.2 | Blend weight of MiDaS in the hybrid depth algorithms; higher = stronger depth relief. |
 | `Enableperspectiveflip` | Enable Perspective Flip | Off | Turns on the perspective flip schedules (theta, phi, gamma, fv); without it they do nothing. |
 | `Fovschedule` | ~ FOV (3D) | 70.0 | 3D camera field of view in degrees; wider = more parallax and stretching. **MOD** (raw: `Fovscheduleraw`) |
diff --git a/scripts/tdeforum/__init__.py b/scripts/tdeforum/__init__.py
index f9e0d63..6829e0b 100644
--- a/scripts/tdeforum/__init__.py
+++ b/scripts/tdeforum/__init__.py
@@ -28,7 +28,7 @@ import this package and forward their callbacks to ``td_controller``.
 import importlib
 import sys
 
-__version__ = "0.12.0"
+__version__ = "0.12.1"
 
 # Leaves first, so dependants pick up reloaded modules.
 _SUBMODULES = ("config", "schedules", "tempo", "modulation", "chop_link", "snapshots", "inputloop", "prompt_seq", "feed", "sweep", "presets", "prompt_presets", "page_presets", "schema",
diff --git a/scripts/tdeforum/payload.py b/scripts/tdeforum/payload.py
index 5d35c7a..903ad87 100644
--- a/scripts/tdeforum/payload.py
+++ b/scripts/tdeforum/payload.py
@@ -417,6 +417,7 @@ def build_request(values, prompts=None, models=None, frame_counter=None,
         settings["padding_mode"] = border_modes(_text(values["border"]))[1]
 
     _check_sampling(values, settings, options, ranges, mode, warnings)
+    _check_depth(settings, warnings)
     if hybrid:
         # Deforum reads the video's frames from <outdir>/hybridframes; extract them every run.
         settings["hybrid_generate_inputframes"] = True
@@ -489,6 +490,21 @@ def build_request(values, prompts=None, models=None, frame_counter=None,
             "warnings": warnings}
 
 
+# Deforum's vendored ZoeDepth runs MiDaS' BEiT backbone, which crashes with the timm in our A1111
+# image on the first warped frame ("'Block' object has no attribute 'target'"). Until the image
+# pins a timm it works with, these are sent as Midas-3-Hybrid instead.
+BROKEN_DEPTH = ("Zoe", "Zoe+AdaBins (old)")
+DEPTH_FALLBACK = "Midas-3-Hybrid"
+
+
+def _check_depth(settings, warnings):
+    algo = settings.get("depth_algorithm")
+    if algo in BROKEN_DEPTH and settings.get("use_depth_warping", True) is not False:
+        settings["depth_algorithm"] = DEPTH_FALLBACK
+        warnings.append("Depth Algorithm %s crashes in this A1111 image (ZoeDepth vs timm: 'Block' object has "
+                        "no attribute 'target'); sent %s instead" % (algo, DEPTH_FALLBACK))
+
+
 def _check_sampling(values, settings, options, ranges, mode, warnings):
     """Settings that quietly ruin renders with LCM checkpoints (and Video Input)."""
     sampler = _text(settings.get("sampler", ""))
diff --git a/scripts/tdeforum/schema.py b/scripts/tdeforum/schema.py
index 5211015..9d0d367 100644
--- a/scripts/tdeforum/schema.py
+++ b/scripts/tdeforum/schema.py
@@ -329,7 +329,9 @@ FIELDS = [
 
     # --- Camera & Depth ---------------------------------------------------------
     F("use_depth_warping", True, CA, TOGGLE),
-    F("depth_algorithm", "Midas-3-Hybrid", CA, MENU, menu=DEPTH_ALGORITHMS),
+    F("depth_algorithm", "Midas-3-Hybrid", CA, MENU, menu=DEPTH_ALGORITHMS,
+      labels=[a + (" (crashes in our image: sent as Midas-3-Hybrid)" if a.startswith("Zoe") else "")
+              for a in DEPTH_ALGORITHMS]),
     F("midas_weight", 0.2, CA, FLOAT, norm=(0, 1)),
     # Without this toggle Deforum ignores every perspective_flip_* schedule (2D and 3D).
     F("enable_perspective_flip", False, CA, TOGGLE),
diff --git a/tests/test_payload.py b/tests/test_payload.py
