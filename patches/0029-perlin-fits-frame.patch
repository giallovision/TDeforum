@@ -505,6 +506,46 @@ def _check_depth(settings, warnings):
                         "no attribute 'target'); sent %s instead" % (algo, DEPTH_FALLBACK))
 
 
+def perlin_fits(h, w, perlin_w, perlin_h, octaves):
+    """Deforum's rand_perlin_2d_octaves builds each octave on a (H, W) grid of
+    (perlin_w * f, perlin_h * f) cells, f = 1, 2, 4 ... 2**(octaves-1); it crashes ("size of tensor a
+    (576) must match ... (512)") unless every grid divides the image exactly. Note the pairing
+    in Deforum's code: Perlin W divides the HEIGHT and Perlin H the WIDTH."""
+    f = 2 ** (max(1, int(octaves)) - 1)
+    return int(h) % (int(perlin_w) * f) == 0 and int(w) % (int(perlin_h) * f) == 0
+
+
+def _fit_perlin(h, w, perlin_w, perlin_h, octaves):
+    """The closest (perlin_w, perlin_h, octaves) that fits: fewer octaves first, then smaller cells."""
+    for octs in range(int(octaves), 0, -1):
+        if perlin_fits(h, w, perlin_w, perlin_h, octs):
+            return perlin_w, perlin_h, octs
+    pw = max(d for d in range(1, int(perlin_w) + 1) if int(h) % d == 0)
+    ph = max(d for d in range(1, int(perlin_h) + 1) if int(w) % d == 0)
+    for octs in range(int(octaves), 0, -1):
+        if perlin_fits(h, w, pw, ph, octs):
+            return pw, ph, octs
+    return pw, ph, 1
+
+
+def _check_perlin(settings, warnings):
+    if settings.get("noise_type", "perlin") != "perlin":
+        return
+    try:
+        h, w = int(settings.get("H", 576)), int(settings.get("W", 1024))
+        pw, ph, octs = (int(settings.get("perlin_w", 8)), int(settings.get("perlin_h", 8)),
+                        int(settings.get("perlin_octaves", 4)))
+    except (TypeError, ValueError):
+        return
+    if pw < 1 or ph < 1 or perlin_fits(h, w, pw, ph, octs):
+        return
+    fixed = _fit_perlin(h, w, pw, ph, octs)
+    settings["perlin_w"], settings["perlin_h"], settings["perlin_octaves"] = fixed
+    warnings.append("Perlin %d x %d with %d octaves does not divide %dx%d (Deforum would crash: 'size of tensor "
+                    "a must match'); sent %d x %d with %d octaves. Rule: Height / (Perlin W x 2^(octaves-1)) and "
+                    "Width / (Perlin H x 2^(octaves-1)) must be whole" % ((pw, ph, octs, w, h) + fixed))
+
+
 def _check_sampling(values, settings, options, ranges, mode, warnings):
     """Settings that quietly ruin renders with LCM checkpoints (and Video Input)."""
     sampler = _text(settings.get("sampler", ""))
diff --git a/tests/test_payload.py b/tests/test_payload.py
index bb8bf1d..d207146 100644
--- a/tests/test_payload.py
+++ b/tests/test_payload.py
@@ -102,6 +102,21 @@ class PayloadTest(unittest.TestCase):
             self.assertEqual(s["cn_%d_weight" % unit], "0:(1.0)")
             self.assertEqual(s["cn_%d_guidance_end" % unit], "0:(0.8)")
 
+    def test_perlin_that_does_not_divide_the_frame_is_fixed(self):
+        # the gvispc1 crash: 1024x576, perlin 8 x 8, 6 octaves -> 8 * 32 = 256 does not divide 576
+        self.assertFalse(payload.perlin_fits(576, 1024, 8, 8, 6))
+        result = payload.build_request(_comp_values(perlin_w=8, perlin_h=8, perlin_octaves=6), {"0": "x"}, MODELS)
+        s = result["request"]["deforum_settings"]
+        self.assertEqual((s["perlin_w"], s["perlin_h"], s["perlin_octaves"]), (8, 8, 4))
+        self.assertTrue(any("Perlin 8 x 8 with 6 octaves" in w for w in result["warnings"]))
+        self.assertTrue(payload.perlin_fits(576, 1024, 4, 4, 3))           # the reference pass
+        ok = payload.build_request(_comp_values(perlin_w=4, perlin_h=4, perlin_octaves=3), {"0": "x"}, MODELS)
+        self.assertFalse(any("Perlin" in w for w in ok["warnings"]))
+        odd = payload._fit_perlin(600, 1000, 7, 3, 2)                      # 7 does not divide 600
+        self.assertTrue(payload.perlin_fits(600, 1000, *odd))
+        for w, h in ((1024, 576), (768, 768), (512, 896)):                  # schema defaults always fit
+            self.assertTrue(payload.perlin_fits(h, w, 4, 4, schema.BY_API["perlin_octaves"].default))
+
     def test_zoe_depth_is_sent_as_midas_with_a_warning(self):
         for algo in ("Zoe", "Zoe+AdaBins (old)"):
             result = payload.build_request(_comp_values(depth_algorithm=algo, animation_mode="3D"), {"0": "x"}, MODELS)
