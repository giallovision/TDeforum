+    t = float(loop_timeline_frame) * render_fps / float(project_rate or 60.0)
+    loop_frames = float(tp["loop_frames"]) if tp else None
+    slots = read_slots(values, warnings)
+    chop_fields = _chop_by_field(chop, warnings)
