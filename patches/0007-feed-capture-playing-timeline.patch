From 2f0c4afddd2c8d527a81da67384424d3e1817dae Mon Sep 17 00:00:00 2001
From: Joseph <joseph@giallovision.com>
Date: Fri, 16 Oct 2026 22:16:02 +0000
Subject: [PATCH] Feed capture: keep the timeline playing; step on Frame End
 and verify the shown frame

A paused TouchDesigner cooks no frames, so no Frame End callback ever arrived.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01BhiEzmwUbwDK67k3BY9b4Y
---
 scripts/tdeforum/td_controller.py | 80 +++++++++++++++++--------------
 tests/_fakes.py                   | 25 ++++++++--
 tests/test_controller.py          | 59 +++++++++++++----------
 3 files changed, 101 insertions(+), 63 deletions(-)

diff --git a/scripts/tdeforum/td_controller.py b/scripts/tdeforum/td_controller.py
index f66b069..d904379 100644
--- a/scripts/tdeforum/td_controller.py
+++ b/scripts/tdeforum/td_controller.py
@@ -49,7 +49,6 @@ BUSY = (COMFY_SUBMITTED, COMFY_RUNNING, DEFORUM_SUBMITTED, DEFORUM_RUNNING, WAIT
 LOST_CONTACT_S = 120.0
 FEED_FINALIZE_TIMEOUT_S = 60.0
