+
+        def pulse():
+            original()
+            seen.append((self.depth.par.index.val, self.script.fetch(sweep.SCRIPT_BAND_KEY)))
+        self.out.par.addframe.pulse = pulse
+        return seen
+
+    def depth_done(self):
