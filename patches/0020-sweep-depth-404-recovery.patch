From aa891a69c0c2eaa8cf4f99856b8082d0766ec9a7 Mon Sep 17 00:00:00 2001
From: Joseph <joseph@giallovision.com>
Date: Sat, 17 Oct 2026 02:58:19 +0000
Subject: [PATCH] Sweep Depth: name the missing file and URL on a ComfyUI 404,
 forget it and remake the depth video once

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01BhiEzmwUbwDK67k3BY9b4Y
---
 scripts/tdeforum/__init__.py      |  2 +-
 scripts/tdeforum/sweep.py         |  9 ++++++-
 scripts/tdeforum/td_controller.py | 36 ++++++++++++++++++++++++-
 tests/test_sweep.py               | 44 +++++++++++++++++++++++++++++++
 4 files changed, 88 insertions(+), 3 deletions(-)

diff --git a/scripts/tdeforum/__init__.py b/scripts/tdeforum/__init__.py
index b4485f3..f11a204 100644
--- a/scripts/tdeforum/__init__.py
+++ b/scripts/tdeforum/__init__.py
@@ -26,7 +26,7 @@ import this package and forward their callbacks to ``td_controller``.
 import importlib
 import sys
 
-__version__ = "0.9.0"
+__version__ = "0.9.1"
 
 # Leaves first, so dependants pick up reloaded modules.
 _SUBMODULES = ("config", "schedules", "tempo", "modulation", "prompt_seq", "feed", "sweep", "presets", "prompt_presets", "page_presets", "schema",
diff --git a/scripts/tdeforum/sweep.py b/scripts/tdeforum/sweep.py
index 17b3802..586abb2 100644
--- a/scripts/tdeforum/sweep.py
+++ b/scripts/tdeforum/sweep.py
@@ -377,7 +377,14 @@ def run_job(job):
         if not os.path.isfile(depth):
             if not job.get("fetch_url"):
                 raise RuntimeError("the depth video is not readable from TouchDesigner: %s" % depth)
-            size = download(job["fetch_url"], depth)
+            try:
+                size = download(job["fetch_url"], depth)
+            except Exception as exc:
+                if getattr(exc, "code", None) == 404:      # ComfyUI has no such output file
+                    result["missing_depth"] = True
+                    raise RuntimeError("ComfyUI has no depth video %s (HTTP 404 from %s)"
+                                       % (os.path.basename(depth), job["fetch_url"]))
+                raise
             result["fetched"] = size
         depth_frames = video_frames(depth)
         plan_info = dict(job["plan"])
diff --git a/scripts/tdeforum/td_controller.py b/scripts/tdeforum/td_controller.py
index 8ef691a..329a164 100644
--- a/scripts/tdeforum/td_controller.py
+++ b/scripts/tdeforum/td_controller.py
@@ -664,7 +664,8 @@ def _start_sweep_render(root, cfg, st):
         values, result = build(root, cfg)
         job = _sweep_job(root, cfg, values, result)
         done = sweep.read_result(job["sidecar"])
-        meta = {"units": [w.unit for w in feed.requests(values) if w.mode == feed.SWEEP],
+        meta = {"depth_retry": bool(st.get("depth_retry")),
+                "units": [w.unit for w in feed.requests(values) if w.mode == feed.SWEEP],
                 "as_mask": payload._as_bool(values.get("sweep_as_mask", False)),
                 "prepare": sweep.prepare_only(values), "out": job["out_container"],
                 "out_share": job["out_share"], "sidecar": job["sidecar"], "init": values.get("video_init_path")}
@@ -703,6 +704,9 @@ def _poll_sweep(root, cfg, st):
 def _after_sweep(root, cfg, st, meta, done):
     """The mask video exists: hand it to the sweep units (and the mask), then carry on."""
     if not done.get("ok"):
+        if done.get("missing_depth") and not meta.get("depth_retry"):
+            _remake_depth(root, cfg, st, done)
+            return
         _fail(root, st, "Sweep Depth render failed: %s" % done.get("error"))
         return
     ui = _op(root, "ui")
@@ -751,6 +755,36 @@ def _alias_depth_cache(root, ui, frames):
     root.store(CACHE_KEY, cache)
 
 
+def _remake_depth(root, cfg, st, done):
+    """The remembered depth video is gone from ComfyUI (deleted, or ComfyUI's output folder
+    changed): forget it everywhere and ask ComfyUI for it again, once."""
+    ui = _op(root, "ui")
+    depth = str(ui.par.Sweepdepthpath.eval() or "") if getattr(ui.par, "Sweepdepthpath", None) else ""
+    log("sweep: %s; forgetting it and making the depth video again" % done.get("error"))
+    cache = dict(root.fetch(CACHE_KEY, {}, search=False) or {})
+    stale = [k for k, v in cache.items() if v == depth]
+    for key in stale:
+        cache.pop(key)
+    root.store(CACHE_KEY, cache)
+    _set_par(ui, "Sweepdepthpath", "")
+    try:
+        values, result = build(root, cfg)
+        if str(values.get("sweep_depth_video", "") or "").strip():
+            _fail(root, st, "Sweep Depth: the Pre-made Depth Video %s is not in ComfyUI's output folder"
+                  % values["sweep_depth_video"])
+            return
+        retry = dict(st, depth_retry=True)
+        if _start_preprocess(root, cfg, values, result, retry, then_render=False, purpose="sweep"):
+            state = _state(root)
+            state["depth_retry"] = True
+            _save(root, state)
+            return
+        _fail(root, st, "Sweep Depth: could not ask ComfyUI for the depth video again")
+    except Exception as exc:
+        traceback.print_exc()
+        _fail(root, st, "Sweep Depth: %s" % exc)
+
+
 def _show_sweep(ui, share_path):
     preview = _inner(ui, "sweep_preview")
     if preview is None:
diff --git a/tests/test_sweep.py b/tests/test_sweep.py
index 5c1e29a..d4c1f47 100644
--- a/tests/test_sweep.py
+++ b/tests/test_sweep.py
@@ -418,6 +418,50 @@ class SweepControllerTest(test_controller.FeedTest.__bases__[0]):
         self.assertEqual(self.state(), ctl.DEFORUM_SUBMITTED)
         self.assertIn("cn_sweep_", self.sent()["cn_1_vid_path"])
 
+    def test_a_depth_video_comfyui_no_longer_has_is_made_again_once(self):
+        import urllib.error
+        fixture = write_depth_video(os.path.join(self.share, "fixture", "d.mp4"), frames=75)
+        calls = []
+
+        def flaky(url, path, timeout=60.0):
+            calls.append(url)
+            if len(calls) == 1:
+                raise urllib.error.HTTPError(url, 404, "Not Found", {}, None)
+            os.makedirs(os.path.dirname(path), exist_ok=True)
+            shutil.copyfile(fixture, path)
+            return os.path.getsize(path)
+        ui = self.make()
+        ctl.queue(self.root)
+        with mock.patch.object(sweep, "download", side_effect=flaky):
+            self.depth_done(on_share=False)
+            self.assertEqual(self.state(), ctl.SWEEP_RENDERING)
+            self.tick()                                   # 404 -> forget it, new ComfyUI job
+            self.assertEqual(self.state(), ctl.COMFY_SUBMITTED)
+            self.assertEqual(ui.par.Sweepdepthpath.val, "")
+            posts = [r for r in self.root.op("webclient_comfyui").requests if r[0] == "POST"]
+            self.assertEqual(len(posts), 2)
+            self.depth_done(on_share=False)
+            self.tick()
+        self.assertEqual(len(calls), 2)
+        self.assertEqual(self.state(), ctl.DEFORUM_SUBMITTED)
+
+    def test_a_second_404_fails_with_the_url(self):
+        import urllib.error
+
+        def gone(url, path, timeout=60.0):
+            raise urllib.error.HTTPError(url, 404, "Not Found", {}, None)
+        ui = self.make()
+        ctl.queue(self.root)
+        with mock.patch.object(sweep, "download", side_effect=gone):
+            self.depth_done(on_share=False)
+            self.tick()
+            self.depth_done(on_share=False)
+            self.tick()
+        self.assertEqual(self.state(), ctl.IDLE)
+        status = ui.par.Pipelinestatus.val
+        self.assertIn("ComfyUI has no depth video", status)
+        self.assertIn("/view?", status)
+
     def test_second_queue_hits_both_caches(self):
         self.run_to_render()
         ctl.cancel(self.root)
