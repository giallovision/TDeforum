new file mode 100644
index 0000000..176faa1
--- /dev/null
+++ b/scripts/tdeforum/__init__.py
@@ -0,0 +1,34 @@
+"""TDeforum pipeline package.
+
+Everything that decides *what* gets sent to Deforum / ComfyUI lives here as
+plain Python, so it can be unit-tested outside TouchDesigner (``make test``).
+
+* ``config``        endpoints, path bridge (container <-> T:/ share), tunables
+* ``schedules``     keyframe-string helpers (bake, checkpoint schedules)
+* ``schema``        the Deforum_UI parameter list (drives UI *and* payload)
+* ``payload``       builds the Deforum batch request + frame plan
+* ``comfy``         builds the ComfyUI preprocess request / reads its history
+* ``td_controller`` TouchDesigner glue: Queue -> preprocess -> render -> load
+
+The DAT scripts in ``scripts/`` stay thin: they put ``scripts/`` on sys.path,
+import this package and forward their callbacks to ``td_controller``.
+"""
+
+import importlib
+import sys
+
+__version__ = "0.2.0"
+
+# Leaves first, so dependants pick up reloaded modules.
+_SUBMODULES = ("config", "schedules", "schema", "payload", "comfy", "td_controller")
+
+
+def reload_all():
+    """Re-import every submodule so edits made in VS Code apply without restarting TD."""
+    for name in _SUBMODULES:
+        full = "%s.%s" % (__name__, name)
+        module = sys.modules.get(full)
+        if module is None:
+            importlib.import_module(full)
+        else:
+            importlib.reload(module)
diff --git a/scripts/tdeforum/comfy.py b/scripts/tdeforum/comfy.py
new file mode 100644
index 0000000..a84b663
--- /dev/null
+++ b/scripts/tdeforum/comfy.py
@@ -0,0 +1,105 @@
+"""ComfyUI preprocessing: build the /prompt request and read /history results.
+
+The workflow template (scripts/templates/TD_CN_PreProc.json) has four nodes:
+10 VHS_LoadVideoPath -> 11 ImageResizeKJv2 -> 19 AIO_Preprocessor -> 21 VHS_VideoCombine
+"""
+
+import copy
+import posixpath
+
+from . import config
+
+
+def cache_name(init_path, width, height, preprocessor, frames):
+    base = posixpath.splitext(posixpath.basename(str(init_path).replace("\\", "/")))[0]
+    return "%s_%dx%d_%s_%df" % (base, int(width), int(height), preprocessor, int(frames))
+
+
+def build_prompt(template, cfg, values, plan, force=False, stamp=""):
+    """Return {"cache_key", "body"} for POST /prompt.
+
+    frame_load_cap uses plan["source_frames"]: the raw frame range Deforum will
+    read from the guide video. In stride mode Deforum strides the ControlNet
+    video itself, so the preprocess must cover the whole range, not max_frames.
+    """
+    width, height = int(values["W"]), int(values["H"])
+    preprocessor = str(values["comfy_preprocessor"])
+    frames = int(plan["source_frames"])
+    key = cache_name(values["video_init_path"], width, height, preprocessor, frames)
+
+    workflow = copy.deepcopy(template)
+    load = workflow["10"]["inputs"]
+    load["video"] = config.to_comfy_input(cfg, values["video_init_path"])
+    load["frame_load_cap"] = frames
+    load["skip_first_frames"] = 0
+    load["select_every_nth"] = 1
+    workflow["11"]["inputs"]["width"] = width
+    workflow["11"]["inputs"]["height"] = height
+    workflow["19"]["inputs"]["preprocessor"] = preprocessor
+    workflow["19"]["inputs"]["resolution"] = min(width, height)
+    # A new prefix changes the output node's inputs, so ComfyUI's cache can't
+    # skip writing the file when a re-preprocess is forced.
+    prefix = "preprocessed_vids/" + key + ("_" + stamp if force and stamp else "")
+    workflow[cfg["comfy_output_node"]]["inputs"]["filename_prefix"] = prefix
+
+    return {"cache_key": key,
+            "body": {"prompt": workflow, "client_id": cfg.get("comfy_client_id", "tdeforum")}}
+
+
+VIDEO_EXTS = (".mp4", ".mov", ".webm", ".mkv", ".gif")
+
+
+def parse_history(history, prompt_id, output_node="21"):
+    """Read GET /history/<id>. Returns (state, subfolder, filename, message).
+
+    state is "pending", "done" or "error".
+    """
+    entry = history.get(prompt_id) if isinstance(history, dict) else None
+    if not entry:
+        return "pending", None, None, None
+
+    status = entry.get("status") or {}
+    if status.get("status_str") == "error":
+        return "error", None, None, _status_error(status) or "ComfyUI reported an error"
+
+    outputs = entry.get("outputs") or {}
+    ordered = [outputs.get(output_node)] + [v for k, v in outputs.items() if k != output_node]
+    for node_out in ordered:
+        if not isinstance(node_out, dict):
+            continue
+        for key in ("gifs", "videos", "images"):
+            for item in node_out.get(key) or []:
+                name = str(item.get("filename", ""))
+                if name.lower().endswith(VIDEO_EXTS):
+                    return "done", str(item.get("subfolder", "")), name, None
+
+    if status.get("completed") is False:
+        return "pending", None, None, None
+    return "error", None, None, "ComfyUI finished without a video output (check node %s)" % output_node
+
+
+def _status_error(status):
+    for message in status.get("messages") or []:
+        if isinstance(message, (list, tuple)) and len(message) == 2 and message[0] == "execution_error":
+            info = message[1] or {}
+            return "%s in node %s: %s" % (info.get("exception_type", "error"),
+                                          info.get("node_id", "?"),
+                                          info.get("exception_message", "").strip())
+    return None
+
+
+def error_text(body, raw_text=""):
+    """Human summary of a rejected POST /prompt."""
+    if isinstance(body, dict):
+        err = body.get("error")
+        parts = []
+        if isinstance(err, dict):
+            parts.append(err.get("message") or err.get("type") or "")
+        node_errors = body.get("node_errors") or {}
+        for node_id, info in node_errors.items():
+            for e in (info or {}).get("errors", []):
+                parts.append("node %s: %s %s" % (node_id, e.get("message", ""), e.get("details", "")))
+        text = "; ".join(p.strip() for p in parts if p and p.strip())
+        if text:
+            return text
+    return (raw_text or "").strip()[:300]
diff --git a/scripts/tdeforum/config.py b/scripts/tdeforum/config.py
new file mode 100644
index 0000000..6f0d60d
--- /dev/null
+++ b/scripts/tdeforum/config.py
@@ -0,0 +1,124 @@
+"""Endpoints, the container <-> share path bridge, and tunables.
+
+Defaults are derived from where this package lives (``<share>/scripts/tdeforum``),
+so a different drive letter needs no edits. Machine-specific overrides go in
+``scripts/tdeforum.local.json`` (git-ignored), for example::
+
+    {"server_host": "10.0.10.42", "poll_interval_s": 1.0}
+"""
+
+import json
+import os
+
+_PKG_DIR = os.path.dirname(os.path.abspath(__file__))
+
+DEFAULTS = {
+    # Linux GPU host running the A1111 container (7865) and ComfyUI (8188).
+    "server_host": "192.168.1.42",
+    "deforum_port": 7865,
+    "comfy_port": 8188,
+    # Container path prefix -> path relative to the share root (T:/).
+    # Mirrors the volume list in docker-compose.yml; longest prefix wins.
+    # NOTE: /opt/a1111/outputs is ./td_outputs on the host, not ./outputs.
+    "path_map": [
+        ["/opt/a1111/outputs/", "td_outputs/"],
+        ["/opt/a1111/td_masks/", "td_masks/"],
+        ["/opt/a1111/td_inputs/", "td_inputs/"],
+    ],
+    # ComfyUI reads td_inputs/comfy_videos as its own input/ folder.
+    "comfy_input_map": [
+        ["/opt/a1111/td_inputs/comfy_videos/", "input/"],
+    ],
+    # ComfyUI output subfolder -> where the A1111 container sees that folder.
+    "comfy_output_map": {
+        "preprocessed_vids": "/opt/a1111/td_masks/preprocessed_vids",
+    },
+    "comfy_output_node": "21",
+    "comfy_client_id": "tdeforum",
+    # Model used when an index in Sdmodelcheckpoint is missing from available_models.
+    "default_checkpoint": "angraRealflexLCMV6_v10.safetensors",
+    # Pipeline timing.
+    "poll_interval_s": 2.0,
+    "submit_timeout_s": 30.0,
+    "file_wait_timeout_s": 180.0,
+    # Re-import the tdeforum package on every button press (VS Code edit loop).
+    "dev_reload": True,
+}
+
+
+def _norm(path):
+    return str(path).replace("\\", "/")
+
+
+def load(local_file=None):
+    """Return the effective config dict (defaults + derived paths + local overrides)."""
+    scripts_dir = _norm(os.path.dirname(_PKG_DIR))
+    share_root = _norm(os.path.dirname(scripts_dir.rstrip("/")))
+    if not share_root.endswith("/"):
+        share_root += "/"
+
+    cfg = json.loads(json.dumps(DEFAULTS))  # deep copy
+    cfg.update({
+        "scripts_dir": scripts_dir,
+        "share_root": share_root,
+        "prompt_file": scripts_dir + "/prompt.json",
+        "comfy_template": scripts_dir + "/templates/TD_CN_PreProc.json",
+        "runtime_dir": share_root + "runtime",
+        "local_file": local_file or scripts_dir + "/tdeforum.local.json",
+    })
+
+    if os.path.isfile(cfg["local_file"]):
+        with open(cfg["local_file"], "r", encoding="utf-8") as fh:
+            overrides = json.load(fh)
+        if isinstance(overrides, dict):
+            cfg.update(overrides)
+    return cfg
+
+
+def deforum_url(cfg, path=""):
+    return "http://%s:%s%s" % (cfg["server_host"], cfg["deforum_port"], path)
+
+
+def comfy_url(cfg, path=""):
+    return "http://%s:%s%s" % (cfg["server_host"], cfg["comfy_port"], path)
+
+
+def _map_prefix(path, pairs):
+    """Replace the longest matching prefix; return None when nothing matches."""
+    path = _norm(path)
+    best = None
+    for src, dst in pairs:
+        if path.startswith(src) and (best is None or len(src) > len(best[0])):
+            best = (src, dst)
+    if best is None:
+        return None
+    return best[1] + path[len(best[0]):]
+
+
+def to_share(cfg, container_path):
+    """'/opt/a1111/outputs/x.mp4' -> 'T:/td_outputs/x.mp4' (None if not on the share)."""
+    rel = _map_prefix(container_path, cfg["path_map"])
+    return None if rel is None else cfg["share_root"] + rel
+
+
+def to_container(cfg, share_path):
+    """Inverse of to_share for paths under the share root."""
+    share_path = _norm(share_path)
+    root = cfg["share_root"]
+    if share_path.lower().startswith(root.lower()):
+        share_path = share_path[len(root):]
+    reverse = [[dst, src] for src, dst in cfg["path_map"]]
+    return _map_prefix(share_path, reverse)
+
+
+def to_comfy_input(cfg, container_path):
+    """Container path of an init video -> path ComfyUI's VHS loader understands."""
+    mapped = _map_prefix(container_path, cfg["comfy_input_map"])
+    return mapped if mapped is not None else _norm(container_path)
+
+
+def comfy_output_to_container(cfg, subfolder, filename):
+    base = cfg["comfy_output_map"].get(subfolder.strip("/"))
+    if base is None:
+        return None
+    return base.rstrip("/") + "/" + filename
diff --git a/scripts/tdeforum/payload.py b/scripts/tdeforum/payload.py
new file mode 100644
index 0000000..8dcf0a0
--- /dev/null
+++ b/scripts/tdeforum/payload.py
@@ -0,0 +1,218 @@
+"""Build the Deforum batch request from Deforum_UI values.
+
+Pure Python: TouchDesigner reads the UI and calls build_request(); tests call
+it with plain dicts. Notes from checking Deforum's source (commit 5d63a339):
+
+* The settings loader only applies keys Deforum knows. ``n_prompt`` is not
+  one, so the negative prompt is sent as ``animation_prompts_negative``.
+* The batch body has two keys: ``deforum_settings`` and ``options_overrides``.
+  A1111 options such as ``sd_vae`` go in ``options_overrides``.
+* ``extract_to_frame`` is inclusive, and in Video Input mode Deforum also applies
+  extract_nth_frame / extract_to_frame to ControlNet guide videos.
+* 2D ``border`` only knows replicate|wrap; 3D ``padding_mode`` knows
+  border|reflection|zeros.
+"""
+
+import math
+
+from . import schedules
+from . import schema
+
+DEFAULT_PROMPTS = {"0": "A cinematic macro shot of liquid gold morphing, biomorphic shapes"}
+DEFAULT_CHECKPOINT = "angraRealflexLCMV6_v10.safetensors"
+CN_UNITS = 5
+
+
+def _text(value):
+    return str(value).strip()
+
+
+def _as_bool(value):
+    if isinstance(value, str):
+        return value.strip().lower() in ("1", "true", "on", "yes")
+    return bool(value)
+
+
+def _as_number(value, cast):
+    try:
+        return cast(value)
+    except (TypeError, ValueError):
+        return cast(float(_text(value)))
+
+
+def coerce(field, value):
+    """Convert a TD parameter value into what Deforum expects for this field."""
+    kind = field.kind
+    if kind == schema.TOGGLE:
+        return _as_bool(value)
+    if field.as_schedule:
+        return schedules.as_schedule(_text(value))
+    if kind == schema.SCHEDULE:
+        return schedules.as_schedule(value)
+    if kind == schema.INT:
+        return int(round(_as_number(value, float)))
+    if kind == schema.FLOAT:
+        return _as_number(value, float)
+    if kind == schema.SEED:
+        text = _text(value)
+        return int(text) if text.lstrip("-").isdigit() else text
+    return _text(value)
+
+
+def border_modes(choice):
+    """UI border choice -> (2D border, 3D padding_mode)."""
+    if choice == "zeros":
+        return "replicate", "zeros"
+    if choice == "wrap":
+        return "wrap", "reflection"
+    return "replicate", "border"
+
+
+def plan_frames(mode, ui_max_frames, frame_mode="trim", use_mask_video=False,
+                init_frames=None, mask_frames=None):
+    """Work out max_frames and the frame-extraction window.
+
+    Returns a dict with max_frames, extract_* settings (or None when Deforum's
+    defaults are fine) and source_frames: how many raw frames Deforum reads
+    from the init / ControlNet videos (what a ComfyUI preprocess must cover).
+    """
+    ui_max_frames = max(1, int(ui_max_frames))
+    plan = {"mode": mode, "frame_mode": frame_mode, "max_frames": ui_max_frames,
+            "extract_from_frame": None, "extract_to_frame": None,
+            "extract_nth_frame": None, "source_frames": ui_max_frames, "limited_by": "ui"}
+
+    if mode == "Video Input":
+        if frame_mode == "stride":
+            asset = init_frames or ui_max_frames
+            nth = max(1, asset // ui_max_frames)
+            available = int(math.ceil(asset / float(nth)))
+            max_frames = min(ui_max_frames, available)
+            limited = "init video" if available < ui_max_frames else "ui"
+            if use_mask_video and mask_frames:
+                mask_available = int(math.ceil(min(mask_frames, asset) / float(nth)))
+                if mask_available < max_frames:
+                    max_frames, limited = mask_available, "mask video"
+            plan.update(max_frames=max_frames, extract_from_frame=0,
+                        extract_to_frame=asset - 1, extract_nth_frame=nth,
+                        source_frames=asset, limited_by=limited)
+        else:
+            cap, limited = ui_max_frames, "ui"
+            if init_frames and init_frames < cap:
+                cap, limited = init_frames, "init video"
+            if use_mask_video and mask_frames and mask_frames < cap:
+                cap, limited = mask_frames, "mask video"
+            plan.update(max_frames=cap, extract_from_frame=0, extract_to_frame=cap - 1,
+                        extract_nth_frame=1, source_frames=cap, limited_by=limited)
+        return plan
+
+    if mode in ("2D", "3D"):
+        cap, limited = ui_max_frames, "ui"
+        if use_mask_video and mask_frames and mask_frames < cap:
+            cap, limited = mask_frames, "mask video"
+        plan.update(max_frames=cap, source_frames=cap, limited_by=limited)
+        if use_mask_video:
+            plan.update(extract_from_frame=0, extract_to_frame=cap - 1, extract_nth_frame=1)
+    return plan
+
+
+def build_request(values, prompts=None, models=None, frame_counter=None,
+                  default_checkpoint=DEFAULT_CHECKPOINT):
+    """Return {"request": body, "plan": frame plan, "warnings": [str]}.
+
+    values         {api_name: value} as read from Deforum_UI (missing keys = not on the UI)
+    prompts        {"frame": "prompt"} timeline
+    models         {"index": "file.safetensors"} from the available_models table
+    frame_counter  callable(container_path) -> int | None, used to cap frame counts
+    """
+    models = models or {}
+    warnings = []
+    settings = {"prompts": dict(prompts or DEFAULT_PROMPTS)}
+    options = {}
+
+    for field in schema.FIELDS:
+        if field.target is None or field.api.startswith("cn_") or field.api not in values:
+            continue
+        raw = values[field.api]
+        text = _text(raw)
+        if text == "" and field.kind != schema.TOGGLE:
+            continue
+
+        if field.kind == schema.CHECKPOINT:
+            settings["enable_checkpoint_scheduling"] = True
+            settings["checkpoint_schedule"] = schedules.checkpoint_schedule(
+                text, models, default_checkpoint)
+            continue
+        if field.api == "border":
+            settings["border"], settings["padding_mode"] = border_modes(text)
+            continue
+
+        try:
+            value = coerce(field, raw)
+        except (TypeError, ValueError):
+            warnings.append("%s: could not read %r, left at Deforum default" % (field.td_name, raw))
+            continue
+        (options if field.target == "options" else settings)[field.key] = value
+
+    # ControlNet: unit 1 from the UI (empty strings are meaningful here), 2-5 off.
+    for field in schema.cn_fields(1):
+        raw = values.get(field.api, field.default)
+        try:
+            settings[field.key] = coerce(field, raw)
+        except (TypeError, ValueError):
+            settings[field.key] = coerce(field, field.default)
+            warnings.append("%s: could not read %r, used %r" % (field.td_name, raw, field.default))
+    for unit in range(2, CN_UNITS + 1):
+        settings["cn_%d_enabled" % unit] = False
+
+    # Output handling the TD side relies on (auto-load expects <outdir>/<timestring>.mp4).
+    use_mask_video = _as_bool(values.get("use_mask_video", False))
+    settings.update(store_frames_in_ram=True, skip_video_creation=False,
+                    use_mask=use_mask_video, overlay_mask=False)
+
+    # Frame plan, capped by the real length of the videos on the share.
+    mode = _text(values.get("animation_mode", "2D"))
+    frame_mode = _text(values.get("video_frame_mode", "trim")) or "trim"
+    ui_max = values.get("max_frames", 240)
+    init_frames = mask_frames = None
+    if frame_counter is not None:
+        if mode == "Video Input":
+            init_frames = _count(frame_counter, values.get("video_init_path"), "init video", warnings)
+        if use_mask_video:
+            mask_frames = _count(frame_counter, values.get("video_mask_path"), "mask video", warnings)
+    plan = plan_frames(mode, ui_max, frame_mode, use_mask_video, init_frames, mask_frames)
+    settings["max_frames"] = plan["max_frames"]
+    for key in ("extract_from_frame", "extract_to_frame", "extract_nth_frame"):
+        if plan[key] is not None:
+            settings[key] = plan[key]
+
+    request = {"deforum_settings": settings}
+    if options:
+        request["options_overrides"] = options
+    return {"request": request, "plan": plan, "warnings": warnings}
+
+
+def _count(counter, path, label, warnings):
+    path = _text(path or "")
+    if not path:
+        return None
+    try:
+        frames = counter(path)
+    except Exception as exc:  # cv2 / share errors must not block a render
+        frames = None
+        warnings.append("%s: frame count failed (%s)" % (label, exc))
+    if frames is None:
+        warnings.append("%s %s not readable from TouchDesigner; frame cap not applied" % (label, path))
+    return frames
+
+
+def summary(result):
+    s = result["request"]["deforum_settings"]
+    plan = result["plan"]
+    parts = [s.get("animation_mode", "?"), "%s frames" % s.get("max_frames")]
+    if plan.get("extract_nth_frame", 1) not in (None, 1):
+        parts.append("stride %d" % plan["extract_nth_frame"])
+    if plan.get("limited_by") not in (None, "ui"):
+        parts.append("capped by %s" % plan["limited_by"])
+    parts.append("%sx%s" % (s.get("W"), s.get("H")))
+    parts.append("CN1 %s" % ("on: " + str(s.get("cn_1_model")) if s.get("cn_1_enabled") else "off"))
+    return " | ".join(parts)
